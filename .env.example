# Leave OPENROUTER_API_KEY unset to use the deterministic local agent provider.
# OpenRouter uses the OpenAI-compatible chat-completions API behind the server-only provider.
OPENROUTER_API_KEY=
# Comma-separated primary + automatic fallback models. Override these with currently
# available OpenRouter model IDs from the Models API as availability changes.
OPENROUTER_MODELS=deepseek/deepseek-chat-v3-0324,meta-llama/llama-3.1-8b-instruct,mistralai/mistral-nemo
# Optional reliability/privacy controls.
# OPENROUTER_TIMEOUT_MS=12000
# OPENROUTER_DATA_COLLECTION=deny
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Shiftline AI Work Simulator
