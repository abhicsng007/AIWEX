# Leave OPENROUTER_API_KEY unset to use the deterministic local agent provider.
# OpenRouter uses the OpenAI-compatible chat-completions API behind the server-only provider.
OPENROUTER_API_KEY=
# Comma-separated primary + automatic fallback models. Override these with currently
# available OpenRouter model IDs from the Models API as availability changes.
OPENROUTER_MODELS=deepseek/deepseek-chat-v3-0324,meta-llama/llama-3.1-8b-instruct,mistralai/mistral-nemo
# Optional reliability/privacy controls.
# OPENROUTER_TIMEOUT_MS=12000
# OPENROUTER_DATA_COLLECTION=deny
# OPENROUTER_SITE_URL=http://localhost:3000
# OPENROUTER_APP_NAME=Shiftline AI Work Simulator

# Optional managed backend. When both variables are set, simulation events are
# persisted in Supabase Postgres and Team Space attachments upload to Storage.
# Keep the service-role key server-only; never prefix it with NEXT_PUBLIC_.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Browser-safe Supabase Auth configuration. This is the publishable/anon key,
# never the service-role key. Configure Google and GitHub in
# the Supabase Authentication dashboard after your deployed URL is known.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key

# Production observability / scenario deployment configuration. Do not put
# platform credentials or production URLs in browser-visible NEXT_PUBLIC_ vars.
# APP_URL=https://your-deployed-domain.example
# SENTRY_DSN=
# SCENARIO_STAGING_URL=https://disposable-scenario-staging.example
# SIMULATION_CRON_SECRET=long-random-secret-used-by-your-scheduler

# Optional isolated Theia workbench beta. It is intentionally disabled by
# default. The app keeps using its built-in workspace unless all values below
# are configured. Never expose THEIA_SESSION_SECRET to the browser.
THEIA_ENABLED=false
# For local development only; production must include {runId} and route each
# learner run to its own isolated workbench instance.
# THEIA_WORKBENCH_URL_TEMPLATE=http://localhost:3001/
# THEIA_WORKBENCH_URL_TEMPLATE=https://theia.example/learner/{runId}/
# THEIA_SESSION_SECRET=at-least-32-random-server-only-characters
# THEIA_SESSION_TTL_SECONDS=300

# Demo mode creates a separate, disposable in-memory learner run through
# /demo. It is enabled by default during local development and is disabled in
# production unless you explicitly set DEMO_MODE=true.
# DEMO_MODE=false
